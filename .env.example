# ===================================================================
# DISASTER PREPAREDNESS AND RESPONSE EDUCATION SYSTEM
# Environment Configuration Template
# ===================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=disaster_response_db
DB_USERNAME=root
DB_PASSWORD=root

# JWT Authentication Security (Minimum 256 bits secret in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Upload Configuration
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=50MB

# Notification Services (Mock in Dev, SMTP/SMS in Production)
NOTIFICATION_PROVIDER=mock
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=mock-user
MAIL_PASSWORD=mock-pass
MAIL_FROM=alerts@disasterprep.gov

# SMS Gateway (Mock in Dev)
SMS_PROVIDER=mock
SMS_API_KEY=mock-api-key
SMS_SENDER_ID=DISASTER_ALERT

# Frontend Client URL (For CORS validation)
FRONTEND_URL=http://localhost:5173
